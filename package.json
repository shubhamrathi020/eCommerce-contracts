{
  "name": "@ecom/contracts",
  "version": "0.1.0",
  "description": "Shared contract for the shop: API types, error codes, and the pure business rules (pricing, promotions, returns, analytics, marketplace) used by both the frontend and the backend.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.0"
  },
  "packageManager": "pnpm@9.15.9"
}
